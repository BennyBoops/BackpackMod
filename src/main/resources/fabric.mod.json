{
  "schemaVersion": 1,
  "id": "backpackmod",
  "version": "${version}",
  "name": "Basic Backpack",
  "description": "Adds a wearable and placeable backpack.",
  "authors": [
    "BennyBoops"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/pocket-repose",
    "sources": "https://github.com/BennyBoops/PocketRepose"
  },
  "license": "MIT",
  "icon": "assets/backpackmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.bennyboops.backpackmod.BackpackMod"
    ],
    "client": [
      "net.bennyboops.backpackmod.BackpackModClient"
    ]
  },


  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  },

  "custom": {
    "fabric-dimensions:use_custom_dimensions": true
  }
}